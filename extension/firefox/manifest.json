{
  "manifest_version": 2,
  "name": "Who's That - Real-time X-Ray",
  "version": "1.0.0",
  "description": "Real-time spoiler-free character overlay",
  "permissions": ["storage", "tabs"],
  "content_scripts": [{
    "matches": ["*://*.netflix.com/*", "*://*.disneyplus.com/*"],
    "js": ["overlay.js"],
    "run_at": "document_start"
  }]
}
