{
  "manifest_version": 3,
  "name": "Who's That - Real-time X-Ray",
  "version": "1.0.0",
  "description": "Real-time spoiler-free character overlay on Netflix/Disney+ web player",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://*.netflix.com/*", "*://*.disneyplus.com/*", "*://*.hbo.com/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
    "matches": ["*://*.netflix.com/*", "*://*.disneyplus.com/*"],
    "js": ["overlay.js"],
    "run_at": "document_start"
  }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Who's That"
  }
}
