{
  "rewrites": [
    {
      "source": "/who-plays/:type/:mediaId/:personId/:slug*",
      "destination": "/api/page?kind=whoplays&type=:type&id=:mediaId&personId=:personId"
    },
    { "source": "/movie/:id/:slug*", "destination": "/api/page?type=movie&id=:id" },
    { "source": "/tv/:id/:slug*", "destination": "/api/page?type=tv&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/index.html"
    }
  }
}
