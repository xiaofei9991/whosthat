{
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "whosthat-app.vercel.app" }],
      "destination": "https://whosthatcast.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/who-plays/:type/:mediaId/:personId/:slug*",
      "destination": "/api/page?kind=whoplays&type=:type&id=:mediaId&personId=:personId"
    },
    {
      "source": "/tv/:id/season-:season(\\d+)/:slug*",
      "destination": "/api/page?kind=season&type=tv&id=:id&season=:season"
    },
    { "source": "/movie/:id/:slug*", "destination": "/api/page?type=movie&id=:id" },
    { "source": "/tv/:id/:slug*", "destination": "/api/page?type=tv&id=:id" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/sitemap-hot.xml", "destination": "/api/sitemap-hot" },
    { "source": "/:page(about|faq|privacy)", "destination": "/api/page?kind=static&page=:page" }
  ],
  "crons": [
    {
      "path": "/api/cron-hot",
      "schedule": "0 8 * * *"
    }
  ],
  "functions": {
    "api/page.js": {
      "includeFiles": "dist/index.html"
    },
    "api/sitemap.js": {
      "maxDuration": 60
    },
    "api/sitemap-hot.js": {
      "maxDuration": 60
    }
  }
}
